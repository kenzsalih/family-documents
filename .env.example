# ==============================================================================
# Family Documents Vault - Environment Configuration Template
# Copy this file to .env.local and fill in the values below.
# NEVER commit .env.local or real secrets to source control.
# ==============================================================================

# 1. PostgreSQL Database Connection String (e.g. Neon Serverless Postgres)
# Obtain from your Neon dashboard -> Project -> Connection Details
# Example: postgresql://neondb_owner:npg_xyz@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 2. Shared Family Master Password Hash (bcrypt, 12 rounds)
# Generate your hash by running: npm run hash-password "YourFamilyPassword"
FAMILY_PASSWORD_HASH=""

# 3. Cryptographic Secret for signing session cookies
# Must be at least 32 characters long.
# Generate on Linux/Mac: openssl rand -hex 32
SESSION_SECRET="change-this-to-a-secure-random-32-byte-hex-string"

# 4. Supabase Storage (Private Object Storage)
# Obtain Project URL and Service Role Key from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (service_role secret)
# Note: Keep the bucket private. Allowed MIME types: PDF, JPEG, PNG (max 25 MB).
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key"
SUPABASE_BUCKET_NAME="family documents"
